generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UsuarioAuthTipo {
  CLIENTE
  SUBCONTA
  OPERACIONAL
}

enum FilialTipo {
  MASTER
  COMUM
}

enum TipoDocumento {
  CPF
  CNPJ
}

enum ClienteStatus {
  ATIVO
  INATIVO
  SUSPENSO
}

enum ContaStatus {
  ATIVA
  SUSPENSA
  ENCERRADA
}

enum PermissionGrantType {
  ALLOW
  DENY
}

model Usuarios {
  idUsuario                        Int                      @id @default(autoincrement())
  usuarioCriadorId                 Int?
  matrizId                         Int?
  nome                             String
  cpf                              String                   @unique
  email                            String                   @unique
  senha                            String
  imagem                           String?
  statusConta                      Boolean?                 @default(true)
  reputacao                        Float?                   @default(0.0)
  razaoSocial                      String?
  nomeFantasia                     String?
  cnpj                             String?
  inscEstadual                     String?
  inscMunicipal                    String?
  mostrarNoSite                    Boolean                  @default(true)
  descricao                        String?
  tipo                             String?
  tipoDeMoeda                      String?
  status                           Boolean                  @default(false)
  restricao                        String?
  nomeContato                      String?
  telefone                         String?
  celular                          String?
  emailContato                     String?
  emailSecundario                  String?
  site                             String?
  logradouro                       String?
  numero                           Int?
  cep                              String?
  complemento                      String?
  bairro                           String?
  cidade                           String?
  estado                           String?
  regiao                           String?
  aceitaOrcamento                  Boolean
  aceitaVoucher                    Boolean
  tipoOperacao                     Int
  categoriaId                      Int?
  subcategoriaId                   Int?
  taxaComissaoGerente              Int?
  permissoesDoUsuario              String                   @default("[]")
  tokenResetSenha                  String?
  bloqueado                        Boolean                  @default(false)
  tipoAuth                         UsuarioAuthTipo          @default(OPERACIONAL)
  clienteId                        Int?
  filialId                         Int?
  createdAt                        DateTime                 @default(now())
  updatedAt                        DateTime                 @updatedAt
  cobrancasGerenciadas             Cobranca[]               @relation("CobrancaToGerente")
  cobrancas                        Cobranca[]               @relation("CobrancaToUsuario")
  contasGerenciadas                Conta[]                  @relation("GerenteToConta")
  conta                            Conta?                   @relation("UsuariosToConta")
  fundoPermuta                     FundoPermuta[]           @relation("UsuarioToFundoPermuta")
  ofertas                          Oferta[]                 @relation("OfertaToUsuario")
  solicitacoesDeCreditoMatriz      SolicitacaoCredito[]     @relation("MatrizToSolicitacao")
  solicitacoesDeCreditoCriadas     SolicitacaoCredito[]     @relation("UsuariosToUsuarioCriador")
  solicitacoesDeCreditoSolicitadas SolicitacaoCredito[]     @relation("SolicitacaoToUsuario")
  transacoesComprador              Transacao[]              @relation("CompradorToUsuario")
  transacoesVendedor               Transacao[]              @relation("VendedorToUsuario")
  categoria                        Categoria?               @relation("UsuarioToCategoria", fields: [categoriaId], references: [idCategoria])
  matriz                           Usuarios?                @relation("MatrizToUsuarios", fields: [matrizId], references: [idUsuario])
  usuariosFilhosDaMatriz           Usuarios[]               @relation("MatrizToUsuarios")
  subcategoria                     Subcategoria?            @relation("UsuarioToSubcategoria", fields: [subcategoriaId], references: [idSubcategoria])
  usuarioCriador                   Usuarios?                @relation("UsuariosToUsuarioCriador", fields: [usuarioCriadorId], references: [idUsuario])
  usuariosCriados                  Usuarios[]               @relation("UsuariosToUsuarioCriador")
  auditorias                       AuditoriaFinanceira[]    @relation("AuditoriaToUsuario")
  clienteAuth                      Cliente?                 @relation("UsuarioClienteAuth", fields: [clienteId], references: [id])
  filialAuth                       Filial?                  @relation("UsuarioFilialAuth", fields: [filialId], references: [id])
  matrizPerfil                     Matriz?                  @relation("UsuarioToMatrizPerfil")
  filialPerfil                     Filial?                  @relation("UsuarioToFilialPerfil")
  permissionGroups                 UsuarioPermissionGroup[]

  @@index([clienteId])
  @@index([filialId])
}

model Matriz {
  id        Int       @id @default(autoincrement())
  nome      String
  cnpj      String    @unique
  descricao String?
  contatos  Json?
  endereco  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  filiais   Filial[]  @relation("MatrizToFilial")
  clientes  Cliente[]
  contas    Conta[]   @relation("MatrizToConta")
  usuarioId Int?      @unique
  usuario   Usuarios? @relation("UsuarioToMatrizPerfil", fields: [usuarioId], references: [idUsuario])
}

model Filial {
  id            Int        @id @default(autoincrement())
  matrizId      Int
  filialPaiId   Int?
  tipo          FilialTipo @default(COMUM)
  nomeFantasia  String
  cnpj          String     @unique
  contatos      Json?
  endereco      Json?
  configuracoes Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  matriz        Matriz     @relation("MatrizToFilial", fields: [matrizId], references: [id])
  filialPai     Filial?    @relation("FilialHierarquia", fields: [filialPaiId], references: [id])
  filiaisFilhas Filial[]   @relation("FilialHierarquia")
  clientes      Cliente[]
  contas        Conta[]
  usuariosAuth  Usuarios[] @relation("UsuarioFilialAuth")
  usuarioId     Int?       @unique
  usuario       Usuarios?  @relation("UsuarioToFilialPerfil", fields: [usuarioId], references: [idUsuario])

  @@index([matrizId])
  @@index([filialPaiId])
}

model Cliente {
  id            Int           @id @default(autoincrement())
  matrizId      Int
  filialId      Int
  razaoSocial   String
  nomeFantasia  String
  documento     String        @unique
  tipoDocumento TipoDocumento
  situacao      ClienteStatus @default(ATIVO)
  contatos      Json?
  endereco      Json?
  limitesPadrao Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  matriz        Matriz        @relation(fields: [matrizId], references: [id])
  filial        Filial        @relation(fields: [filialId], references: [id])
  contas        Conta[]
  usuariosAuth  Usuarios[]    @relation("UsuarioClienteAuth")

  @@index([matrizId])
  @@index([filialId])
}

model Conta {
  idConta               Int         @id @default(autoincrement())
  clienteId             Int?
  filialId              Int?
  matrizId              Int?
  taxaRepasseMatriz     Int?
  limiteCredito         Float       @default(0.0)
  limiteUtilizado       Float       @default(0.0)
  saldoPermuta          Float       @default(0.0)
  limiteVendaMensal     Float
  limiteVendaTotal      Float
  limiteVendaEmpresa    Float
  valorVendaMensalAtual Float       @default(0.0)
  valorVendaTotalAtual  Float       @default(0.0)
  diaFechamentoFatura   Int
  dataVencimentoFatura  Int
  numeroConta           String      @unique
  dataDeAfiliacao       DateTime?
  nomeFranquia          String?
  tipoContaId           Int?
  usuarioId             Int?        @unique
  planoId               Int?
  gerenteContaId        Int?
  status                ContaStatus @default(ATIVA)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  permissoesEspecificas String?     @default("[]")
  limiteDisponivel      Float?
  saldoDinheiro         Float       @default(0.0)
  formaPagamentoPlano   String?     @default("0")
  valorPlanoPermuta     Float       @default(0.0)
  valorPlanoDinheiro    Float       @default(0.0)
  cobrancas             Cobranca[]  @relation("CobrancaToConta")
  gerenteConta          Usuarios?   @relation("GerenteToConta", fields: [gerenteContaId], references: [idUsuario])
  plano                 Plano?      @relation("ContaToPlano", fields: [planoId], references: [idPlano])
  tipoDaConta           TipoConta?  @relation("TipoContaToConta", fields: [tipoContaId], references: [idTipoConta])
  usuario               Usuarios?   @relation("UsuariosToConta", fields: [usuarioId], references: [idUsuario], map: "contaUsuarioId")
  cliente               Cliente?    @relation(fields: [clienteId], references: [id])
  filial                Filial?     @relation(fields: [filialId], references: [id])
  matriz                Matriz?     @relation("MatrizToConta", fields: [matrizId], references: [id])
  subContas             SubContas[] @relation("SubContasToConta")

  @@index([clienteId])
  @@index([filialId])
  @@index([matrizId])
}

model TipoConta {
  idTipoConta      Int     @id @default(autoincrement())
  tipoDaConta      String
  prefixoConta     String
  descricao        String
  permissoes       String  @default("[]")
  contasAssociadas Conta[] @relation("TipoContaToConta")
}

model Plano {
  idPlano             Int      @id @default(autoincrement())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  nomePlano           String
  tipoDoPlano         String?
  imagem              String?
  taxaInscricao       Float
  taxaComissao        Float
  taxaManutencaoAnual Float
  contas              Conta[]  @relation("ContaToPlano")
}

model SubContas {
  idSubContas         Int         @id @default(autoincrement())
  nome                String
  email               String      @unique
  cpf                 String      @unique
  numeroSubConta      String      @unique
  senha               String
  imagem              String?
  statusConta         Boolean?    @default(true)
  reputacao           Float?      @default(0.0)
  telefone            String?
  celular             String?
  emailContato        String?
  logradouro          String?
  numero              Int?
  cep                 String?
  complemento         String?
  bairro              String?
  cidade              String?
  estado              String?
  contaPaiId          Int
  permissoes          String      @default("[]")
  tokenResetSenha     String?
  cobrancas           Cobranca[]  @relation("CobrancaToSubConta")
  ofertas             Oferta[]    @relation("OfertaToSubConta")
  contaPai            Conta       @relation("SubContasToConta", fields: [contaPaiId], references: [idConta])
  transacoesComprador Transacao[] @relation("CompradorToSubConta")
  transacoesVendedor  Transacao[] @relation("VendedorToSubConta")
}

model Oferta {
  idOferta       Int           @id @default(autoincrement())
  createdAt      DateTime      @default(now())
  idFranquia     Int?
  nomeFranquia   String?
  titulo         String
  tipo           String
  status         Boolean
  descricao      String
  quantidade     Int
  valor          Float
  limiteCompra   Float
  vencimento     DateTime
  cidade         String
  estado         String
  retirada       String
  obs            String
  imagens        String[]
  usuarioId      Int?
  nomeUsuario    String
  categoriaId    Int?
  subcategoriaId Int?
  subcontaId     Int?
  imagensUp      Imagem[]
  categoria      Categoria?    @relation("OfertaToCategoria", fields: [categoriaId], references: [idCategoria])
  subcategoria   Subcategoria? @relation("OfertaToSubcategoria", fields: [subcategoriaId], references: [idSubcategoria])
  subconta       SubContas?    @relation("OfertaToSubConta", fields: [subcontaId], references: [idSubContas])
  usuario        Usuarios?     @relation("OfertaToUsuario", fields: [usuarioId], references: [idUsuario])
  transacoes     Transacao[]
}

model Imagem {
  id        Int    @id @default(autoincrement())
  public_id String
  url       String
  ofertaId  Int
  oferta    Oferta @relation(fields: [ofertaId], references: [idOferta])
}

model Categoria {
  idCategoria   Int            @id @default(autoincrement())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  nomeCategoria String
  tipoCategoria String?
  ofertas       Oferta[]       @relation("OfertaToCategoria")
  subcategorias Subcategoria[]
  usuarios      Usuarios[]     @relation("UsuarioToCategoria")
}

model Subcategoria {
  idSubcategoria   Int        @id @default(autoincrement())
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  nomeSubcategoria String
  categoriaId      Int
  ofertas          Oferta[]   @relation("OfertaToSubcategoria")
  categoria        Categoria  @relation(fields: [categoriaId], references: [idCategoria])
  usuarios         Usuarios[] @relation("UsuarioToSubcategoria")
}

model Transacao {
  idTransacao                    Int                   @id @default(autoincrement())
  codigo                         String                @default(uuid()) @db.Uuid
  createdAt                      DateTime              @default(now())
  dataDoEstorno                  DateTime?
  nomeComprador                  String
  nomeVendedor                   String
  compradorId                    Int?
  vendedorId                     Int?
  saldoUtilizado                 String
  valorRt                        Float
  valorAdicional                 Float
  saldoAnteriorComprador         Float
  saldoAposComprador             Float
  saldoAnteriorVendedor          Float
  saldoAposVendedor              Float
  limiteCreditoAnteriorComprador Float?
  limiteCreditoAposComprador     Float?
  numeroParcelas                 Int
  descricao                      String
  notaAtendimento                Int
  observacaoNota                 String
  status                         String
  emiteVoucher                   Boolean               @default(false)
  ofertaId                       Int?
  subContaCompradorId            Int?
  subContaVendedorId             Int?
  comissao                       Float
  comissaoParcelada              Float
  cobrancas                      Cobranca[]
  parcelamento                   Parcelamento[]
  comprador                      Usuarios?             @relation("CompradorToUsuario", fields: [compradorId], references: [idUsuario])
  oferta                         Oferta?               @relation(fields: [ofertaId], references: [idOferta])
  vendedor                       Usuarios?             @relation("VendedorToUsuario", fields: [vendedorId], references: [idUsuario])
  subContaComprador              SubContas?            @relation("CompradorToSubConta", fields: [subContaCompradorId], references: [idSubContas], map: "transacaoSubContaCompradorId")
  subContaVendedor               SubContas?            @relation("VendedorToSubConta", fields: [subContaVendedorId], references: [idSubContas], map: "transacaoSubContaVendedorId")
  voucher                        Voucher[]
  auditorias                     AuditoriaFinanceira[] @relation("AuditoriaToTransacao")
}

model Parcelamento {
  idParcelamento  Int       @id @default(autoincrement())
  numeroParcela   Int
  valorParcela    Float
  comissaoParcela Float
  transacaoId     Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  transacao       Transacao @relation(fields: [transacaoId], references: [idTransacao])
}

model Voucher {
  idVoucher        Int       @id @default(autoincrement())
  codigo           String    @default(uuid()) @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  dataCancelamento DateTime?
  transacaoId      Int
  status           String?   @default("Ativo")
  transacao        Transacao @relation(fields: [transacaoId], references: [idTransacao])
}

model Cobranca {
  idCobranca       Int        @id @default(autoincrement())
  valorFatura      Float
  referencia       String
  createdAt        DateTime   @default(now())
  status           String?
  transacaoId      Int?
  usuarioId        Int?
  contaId          Int?
  vencimentoFatura DateTime?
  subContaId       Int?
  gerenteContaId   Int?
  conta            Conta?     @relation("CobrancaToConta", fields: [contaId], references: [idConta])
  gerente          Usuarios?  @relation("CobrancaToGerente", fields: [gerenteContaId], references: [idUsuario])
  transacao        Transacao? @relation(fields: [transacaoId], references: [idTransacao])
  usuario          Usuarios?  @relation("CobrancaToUsuario", fields: [usuarioId], references: [idUsuario])
  subConta         SubContas? @relation("CobrancaToSubConta", fields: [subContaId], references: [idSubContas], map: "cobrancaSubContaId")
}

model SolicitacaoCredito {
  idSolicitacaoCredito Int       @id @default(autoincrement())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  valorSolicitado      Float
  status               String
  motivoRejeicao       String?
  usuarioSolicitanteId Int
  descricaoSolicitante String?
  comentarioAgencia    String?
  matrizAprovacao      Boolean?
  comentarioMatriz     String?
  usuarioCriadorId     Int
  matrizId             Int?
  matriz               Usuarios? @relation("MatrizToSolicitacao", fields: [matrizId], references: [idUsuario])
  usuarioCriador       Usuarios  @relation("UsuariosToUsuarioCriador", fields: [usuarioCriadorId], references: [idUsuario])
  usuarioSolicitante   Usuarios  @relation("SolicitacaoToUsuario", fields: [usuarioSolicitanteId], references: [idUsuario])
}

model FundoPermuta {
  idFundoPermuta Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  valor          Float
  usuarioId      Int
  usuario        Usuarios @relation("UsuarioToFundoPermuta", fields: [usuarioId], references: [idUsuario])
}

// FASE 2.1 - Sistema de Auditoria Financeira
model AuditoriaFinanceira {
  id               String   @id @default(uuid())
  timestamp        DateTime @default(now())
  usuarioId        Int?
  usuarioExecutor  String? // Nome ou identificação de quem executou
  acao             String // "TRANSACAO", "ESTORNO", "AJUSTE_SALDO", "CRIAR_COBRANCA"
  entidade         String // "TRANSACAO", "CONTA", "COBRANCA", "VOUCHER"
  entidadeId       Int? // ID da entidade afetada
  dadosAnteriores  Json? // Estado anterior dos dados
  dadosNovos       Json? // Estado novo dos dados
  valorOperacao    Float? // Valor da operação financeira
  contasAfetadas   Json? // Array com IDs das contas afetadas
  transacaoId      Int? // ID da transação relacionada (se aplicável)
  ipAddress        String?
  userAgent        String?
  detalhesOperacao String? // Descrição detalhada da operação
  resultado        String // "SUCESSO", "ERRO", "PENDENTE"
  tempoExecucao    Int? // Tempo de execução em ms
  sessionId        String? // ID da sessão do usuário

  // Relacionamentos
  usuario   Usuarios?  @relation("AuditoriaToUsuario", fields: [usuarioId], references: [idUsuario])
  transacao Transacao? @relation("AuditoriaToTransacao", fields: [transacaoId], references: [idTransacao])

  @@index([timestamp])
  @@index([usuarioId])
  @@index([acao])
  @@index([transacaoId])
  @@index([resultado])
}

model PermissionGroup {
  id             Int                         @id @default(autoincrement())
  nome           String
  descricao      String?
  isDefault      Boolean                     @default(false)
  defaultForTipo String?
  herdaDoGrupoId Int?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  herdaDoGrupo   PermissionGroup?            @relation("PermissionGroupHierarchy", fields: [herdaDoGrupoId], references: [id])
  subGrupos      PermissionGroup[]           @relation("PermissionGroupHierarchy")
  assignments    PermissionGroupAssignment[]
  usuarios       UsuarioPermissionGroup[]

  @@index([herdaDoGrupoId])
  @@index([defaultForTipo])
}

model Permission {
  id          Int                         @id @default(autoincrement())
  categoria   String
  chave       String
  descricao   String?
  ordem       Int?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  assignments PermissionGroupAssignment[]

  @@unique([categoria, chave])
}

model PermissionGroupAssignment {
  id           Int                 @id @default(autoincrement())
  groupId      Int
  permissionId Int
  valor        Boolean             @default(false)
  grantType    PermissionGrantType @default(ALLOW)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  group        PermissionGroup     @relation(fields: [groupId], references: [id])
  permission   Permission          @relation(fields: [permissionId], references: [id])

  @@unique([groupId, permissionId])
  @@index([permissionId])
}

model UsuarioPermissionGroup {
  id               Int             @id @default(autoincrement())
  usuarioId        Int
  groupId          Int
  escopo           String          @default("DEFAULT")
  permissoesExtras Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  usuario          Usuarios        @relation(fields: [usuarioId], references: [idUsuario])
  group            PermissionGroup @relation(fields: [groupId], references: [id])

  @@index([usuarioId])
  @@index([groupId])
}
